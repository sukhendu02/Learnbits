<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Mangae blogs</title>


    <style>

        .tag{
                 background-color: #eef;
      color: #336;
      padding: 2px 8px;
      border-radius: 12px;
      margin-right: 5px;
      font-size: 12px;
    }
    .blog-card {
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
      border-radius: 8px;
      padding: 30px;
      height: 100%;
      width: 40%;
      font-size: 14px;
    }
    .view-btn{
      border-radius: 8px;
      border: 2px solid #4DB6AC;
      padding: 6px 20px;
  background-color: #4DB6AC;
  color: #fff;
    }
    .blog-box{
      flex-wrap: wrap;
      justify-content: space-evenly;
    }
    .btn-status{
      border: none;
      border-radius: 8px;
      padding: 6px 16px;
      font-size: 13px;
      margin: 2px;

    }
    #feedback{
      border: 1.5px solid #4DB6AC;
      width: 100%;
      border-radius: 12px;
    }
    .blog-status{
          display: inline;
    padding: 2px 6px;
    border-radius: 14px;
    }


    
      @media only screen and (max-width: 767px) {
        /* Force table to not be like tables anymore */
        table,
        thead,
        tbody,
        th,
        td,
        tr {
          display: block;
          /* Hide table headers (but not display: none;, for accessibility) */
        }
        thead tr,
        tfoot tr {
          position: absolute;
          top: -9999px;
          left: -9999px;
        }
        td {
          /* Behave  like a "row" */
          border: none;
          border-bottom: 1px solid #eee;
          position: relative;
          padding-left: 50% !important;
        }
        td:before {
          /* Now like a table header */
          position: absolute;
          /* Top/left values mimic padding */
          top: 6px;
          left: 6px;
          width: 45%;
          padding-right: 10px;
          white-space: nowrap;
        }
        .table td:nth-child(1) {
          background: #ccc;
          height: 100%;
          top: 0;
          left: 0;
          font-weight: bold;
          /*
     Label the data
     */
        }
        td:nth-of-type(1):before {
          content: "#";
        }
        td:nth-of-type(2):before {
          content: "Question";
        }
        td:nth-of-type(3):before {
          content: "Topic";
        }
        td:nth-of-type(4):before {
          content: "Difficulty";
        }
        td:nth-of-type(5):before {
          content: "View";
        }
        td:nth-of-type(6):before {
          content: "Update";
        }
        td:nth-of-type(7):before {
          content: "Delete";
        }
        .dataTables_length {
          display: none;
        }
      }



div#DataTables_Table_0_length label {
  display: flex;
  font-weight: 500;
  align-items: center;
  padding: 6px 0px;
}
div#DataTables_Table_0_length label select{
  margin: 0px 5px;
  outline: none;
  box-shadow: none;
  width: fit-content;
}
div#DataTables_Table_0_filter label{
  font-weight: 500;
}
div#DataTables_Table_0_filter label input{
  padding: 8px;
  border: 2px solid #ccc;
  border-radius: 8px;
}

div#DataTables_Table_0_info{
  font-weight: 500;
  color: #919090;
}

  thead tr{
        background-color: #617CEA;
        color: #fff;
      }
      #manage-blog-nav-item{
        background-color: #617CEA;
        color: #fff;
        border-radius: 12px;
      }
    </style>
</head>
<body class="bg-light">

  {{>adminsidenav}}
  <div class="main">

 <div class="container">



    <h2>Manage Blogs</h2>
 
{{#if messages.failed}}
<div class="alert alert-danger" role="alert">
  {{!-- A simple primary alert—check it out! --}}
  {{messages.failed}}
  ya
  {{messages}}
</div>
{{/if}}
{{#if messages.sucess}}
<div class="alert alert-danger" role="alert">

  sdfjk
  {{message}}
</div>
{{/if}}


    <table
        class="table table-bordered table-striped table-hover"
        cellspacing="0"
        width="100%"
      >


      {{!-- <div class="mb-3">
  <label for="statusFilter" class="form-label">Filter by Status:</label>
  <select id="statusFilter" class="form-select" style="width: 200px;">
    <option value="">All</option>
    <option value="In review">In review</option>
    <option value="approved">Approved</option>
    <option value="Rejected">Rejected</option>
  </select>
</div> --}}

        <thead>
          <tr>
            <th style="width: 12px;" class="col-md">#</th>
            <th class="col-md-2">Title</th>
            <th class="col-md-2">Category</th>
            <th class="col-md-2">Brief</th>
            <th class="col-md-2">Last Updated</th>
            <th class="col-md-1">Status</th>
            <th style="padding-right: 25px;
    padding-left: 12px;width:30px" class="">Action</th>

          </tr>
        </thead>
        <tfoot>
          <tr>
         <th>#</th>
            <th>Title</th>
            <th>Category</th>
            <th>Brief</th>
            <th>Last Updated</th>
            <th>Status</th>
            <th>Action</th>
            
          </tr>
        </tfoot>
        <tbody>
           {{#each allBlogs}}
          <tr>

              <td>{{inc @index}}</td>
            <td>{{blog_title}}</td>
            <td>{{blog_category}}</td>
            <td>{{blog_brief}}</td>
            <td>{{formatDate createdAt}}</td>
            <td>
              {{#isEqual   status "in-review"}}
                           <span style="font-size: 13px;white-space: nowrap; font-family:'Inter';letter-spacing:1px" class="fw-bold text-primary pr-2">{{status}} 
                            </span><br>
                            <small>{{feedback}}</small>
                            
                            {{/isEqual}}
                {{#isEqual   status "approved"}}
                            <span style="font-size: 13px;white-space: nowrap; font-family:'Inter';letter-spacing:1px" class="fw-bold text-success pr-2">{{status}} 
                            </span><br>
                              <small>{{feedback}}</small>
                            {{/isEqual}}
                {{#isEqual   status "needs-improvement"}}
                            <span style="font-size: 13px;white-space: nowrap; font-family:'Inter';letter-spacing:1px" class="fw-bold text-warning pr-2">{{status}} 
                            </span><br>
                              <small>{{feedback}}</small>
                            {{/isEqual}}
                {{#isEqual   status "rejected"}}
                            <span style="font-size: 13px;white-space: nowrap; font-family:'Inter';letter-spacing:1px" class="fw-bold text-danger pr-2">{{status}} 
                            </span><br>
                              <small>{{feedback}}</small>
                            {{/isEqual}}
            </td>
            <td class="text-center">
          <button class="view-btn" data-bs-toggle="modal" data-bs-target="#staticBackdrop{{@index}}" >Show</button>
              </td>
            
   
          </tr>



          <!-- Modal -->
       <!-- Modal -->
<div class="modal fade" id="staticBackdrop{{@index}}" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="staticBackdropLabel"> {{blog_title}}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
       {{{blog_post}}}
      </div>
      
      <div class="modal-footer d-flex justify-content-between">
        <div>
          <label for="" style="font-size: 12px;color:#336">Feedback</label>
          <textarea  name="feedback" id="feedback"></textarea>
        </div>
        <div>

      {{!-- <a href="/blog/{{_id}}"> --}}
       <button class="btn-status bg-success text-light" onclick="updateBlogStatus('{{_id}}', 'approved', {{@index}})"><i class="fa fa-check-circle"></i>Publish</button>
      {{!-- </a>  --}}
        {{!-- <button class="btn-status bg-warning text-light " onclick="updateBlogStatus('{{_id}}', 'approved', {{@index}})"><i class="fa fa-shield"></i> Needs-Improvement</button> --}}
        <button class="btn-status bg-warning text-light" onclick="updateBlogStatus('{{_id}}', 'needs-improvement', {{@index}})">
  <i class="fa fa-shield"></i> Needs Improvement
</button>
        <button class="btn-status bg-danger text-light" onclick="updateBlogStatus('{{_id}}', 'rejected', {{@index}})"><i class="fa fa-xmark"></i> Reject</button>
        </div>
   
      </div>
    </div>
  </div>
</div>
         
        {{/each}}
          
       
        </tbody>
      </table>


 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
    <!-- Datatables -->
    <script src="https://cdn.datatables.net/1.10.15/js/jquery.dataTables.min.js"></script>
    <!-- Bootstrap -->
    <script
      src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"
      integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa"
      crossorigin="anonymous"
    ></script>
<script>


   $(document).ready(function () {
        $(".table").DataTable({
          // Disable sorting on the last column
          columnDefs: [{ orderable: false, targets: 5 }],
          language: {
            // Customize pagination prev and next buttons: use arrows instead of words
            paginate: {
              previous: '<span class="fa fa-chevron-left"></span>',
              next: '<span class="fa fa-chevron-right"></span>'
            },
            // Customize the number of elements to be displayed
            lengthMenu:
              'Display <select class="form-control input-sm">' +
              '<option value="10">10</option>' +
              '<option value="20">20</option>' +
              '<option value="30">30</option>' +
              '<option value="40">40</option>' +
              '<option value="50">50</option>' +
              '<option value="-1">All</option>' +
              "</select> results"
          }
        });
   })

 function updateBlogStatus(blogId, status, index) {
    const feedbackTextarea = document.querySelector(`#staticBackdrop${index} #feedback`);
    const feedback = feedbackTextarea ? feedbackTextarea.value : '';

    fetch(`/admin/blog/update-status/${blogId}`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ status, feedback })
    })
    .then(res => res.json())
    .then(data => {
      if (data.message) {
        alert(data.message);
        location.reload(); // Refresh the page to reflect the updated status
      }
    })
    .catch(err => {
      console.error('Error:', err);
     alert('Failed to update blog status.');
    });
 }
 
</script>
</body>
</html>