  <div class="p-4 rounded-4 shadow-sm bg-light border border-2 border-primary">
    <h4 class="fw-bold text-primary mb-3">🎉 Earn Reward Coins for Every Action!</h4>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-2 g-4">
      
      <div class="col">
        <div class="d-flex align-items-center p-3 bg-white rounded-3 shadow-sm h-100">
          <div class="me-3 fs-3 text-warning">📝</div>
          <div>
            <h6 class="mb-1">Submit Interview Experience</h6>
            <span class="badge bg-success">+20 Coins</span>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="d-flex align-items-center p-3 bg-white rounded-3 shadow-sm h-100">
          <div class="me-3 fs-3 text-primary">🎮</div>
          <div>
            <h6 class="mb-1">Register for a Contest</h6>
            <span class="badge bg-success">+10 Coins</span>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="d-flex align-items-center p-3 bg-white rounded-3 shadow-sm h-100">
          <div class="me-3 fs-3 text-danger">🏆</div>
          <div>
            <h6 class="mb-1">Win a Contest</h6>
            <span class="badge bg-success">+50 Coins</span>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="d-flex align-items-center p-3 bg-white rounded-3 shadow-sm h-100">
          <div class="me-3 fs-3 text-secondary">📚</div>
          <div>
            <h6 class="mb-1">Write a Blog or Tutorial</h6>
            <span class="badge bg-success">+10 Coins</span>
          </div>
        </div>
      </div>

      

    </div>
  </div>
</div>
                    </div>
                </div>


<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center p-4 rounded-4 shadow-md" style="background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); border: 1px solid #e0e0e0;">
    <div class="d-flex align-items-start gap-3">
      <div class="bg-primary bg-gradient text-white d-flex align-items-center justify-content-center rounded-circle" style="width: 50px; height: 50px;">
        <img width="54px" src="/images/lb-coin-removebg-preview.png" alt="">
      </div>
      <div>
        <h6 class="mb-1 fw-bold">Check Your Contributions & Redeem Coins</h6>
        <p class="mb-0 text-muted" style="font-size: 14px;">
          Visit your <strong>Profile → Wallet</strong> to view your earned coins and redeem exciting rewards.
        </p>
      </div>
    </div>
    <a href="/profile/my-wallet" class="btn btn-primary fw-semibold px-4 py-2 rounded-pill">Go to Profile</a>
  </div>
</div>

    
    <div class="interview-exp-banner">
                        <!-- Include this where you want to show the banner -->
<div class="container my-4 ">
  <div class="p-5 rounded-4 shadow d-flex flex-column flex-md-row justify-content-between align-items-center bg-gradient bg-primary text-white banner-box">
    
    <div class="mb-3 mb-md-0">
      <h3 class="fw-bold mb-3">📝 Share Your Interview Experience!</h3>
      <p class="mb-2">Help others by sharing your journey and <strong>earn exciting rewards</strong> 🎁</p>
      <span class="badge bg-warning text-dark fs-6 py-3 px-3 my-3">Get Assured <img width="25px" src="/images/lb-coin-removebg-preview.png" alt=""> 20 coins</span>
    </div>
    
    <div>
      <a href="/interview-prep/write-interview-experience" class="btn btn-light text-primary fw-semibold px-5 py-3 rounded-pill shadow-sm">
        Share Now
